# Copy this file to .env and fill in the values. .env is gitignored.
# Never paste these values into chat, commit them, or print them in logs.

# --- Discord ---
# Bot token from the Discord Developer Portal (Bot tab > Reset Token).
DISCORD_BOT_TOKEN=

# --- Database (Neon Postgres via the Vercel Marketplace) ---
# Connection string from the Neon or Vercel dashboard.
DATABASE_URL=

# --- Anthropic (analysis) ---
ANTHROPIC_API_KEY=
# Small, low-cost model used for tagging by default. Change only if you want a bigger model.
ANTHROPIC_MODEL=claude-haiku-5-5
# Scheduled runs stop before analysis if the estimated cost is above this (US dollars).
PULSE_SPENDING_CAP_USD=5

# --- Resend (email) ---
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
REPORT_FROM_EMAIL=Community Pulse <pulse@example.com>

# --- Portal (web/) ---
# Public URL of the deployed portal, used for links in reports and emails.
PORTAL_URL=http://localhost:3000
# Comma-separated list of email addresses allowed to sign in to the portal.
PORTAL_ALLOWED_EMAILS=you@example.com
# Random secret for signing login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=
